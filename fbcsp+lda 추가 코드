# ===== FBGCN용 FBCSP Feature 추출 + LDA 평가 + t-SNE =====
import os
import numpy as np
from mne.decoding import CSP
from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as LDA
from sklearn.metrics import accuracy_score, roc_auc_score
from sklearn.manifold import TSNE
import matplotlib.pyplot as plt

FOLD_DIR = "C:/Users/mimi0/OneDrive/바탕 화면/fold_segment_fbcsp"
SAVE_DIR = "C:/Users/mimi0/OneDrive/바탕 화면/fbcsp_result/fbcsp_features_fbgcn"
os.makedirs(SAVE_DIR, exist_ok=True)

N_FOLDS = 5
N_CSP_COMPONENTS = 4
n_channels = 22

acc_list, auc_list = [], []
all_features, all_labels = [], []

for fold in range(N_FOLDS):
    X_train = np.load(os.path.join(FOLD_DIR, f"X_train_fold{fold}.npy"), allow_pickle=True).astype(np.float64)
    y_train = np.load(os.path.join(FOLD_DIR, f"y_train_fold{fold}.npy"), allow_pickle=True)
    X_test = np.load(os.path.join(FOLD_DIR, f"X_test_fold{fold}.npy"), allow_pickle=True).astype(np.float64)
    y_test = np.load(os.path.join(FOLD_DIR, f"y_test_fold{fold}.npy"), allow_pickle=True)

    N, B, C, T = X_train.shape
    n_bands = B

    X_train_fbgcn = np.zeros((X_train.shape[0], n_channels, n_bands))
    X_test_fbgcn = np.zeros((X_test.shape[0], n_channels, n_bands))
    lda_concat_train, lda_concat_test = [], []

    for b in range(B):
        Xb_train = X_train[:, b]  # (n_samples, n_channels, n_times)
        Xb_test = X_test[:, b]

        csp = CSP(n_components=N_CSP_COMPONENTS, reg=None, log=True, norm_trace=False)
        Xb_train_csp = csp.fit_transform(Xb_train, y_train)
        Xb_test_csp = csp.transform(Xb_test)

        # ====== FBGCN용 채널별 벡터 구성 (단순 매핑 기반) ======
        X_train_avg = Xb_train_csp.reshape(Xb_train.shape[0], N_CSP_COMPONENTS // 2, 2).mean(axis=2)
        X_test_avg = Xb_test_csp.reshape(Xb_test.shape[0], N_CSP_COMPONENTS // 2, 2).mean(axis=2)

        for i in range(n_channels):
            X_train_fbgcn[:, i, b] = X_train_avg[:, i % (N_CSP_COMPONENTS // 2)]
            X_test_fbgcn[:, i, b] = X_test_avg[:, i % (N_CSP_COMPONENTS // 2)]

        # ====== LDA용 전체 feature vector 저장 ======
        lda_concat_train.append(Xb_train_csp)
        lda_concat_test.append(Xb_test_csp)

    # 저장 (FBGCN 학습용)
    np.save(os.path.join(SAVE_DIR, f"X_train_fbgcn_fold{fold}.npy"), X_train_fbgcn)
    np.save(os.path.join(SAVE_DIR, f"X_test_fbgcn_fold{fold}.npy"), X_test_fbgcn)
    np.save(os.path.join(SAVE_DIR, f"y_train_fold{fold}.npy"), y_train)
    np.save(os.path.join(SAVE_DIR, f"y_test_fold{fold}.npy"), y_test)

    # ====== LDA 평가 ======
    X_train_concat = np.concatenate(lda_concat_train, axis=1)
    X_test_concat = np.concatenate(lda_concat_test, axis=1)

    clf = LDA()
    clf.fit(X_train_concat, y_train)
    preds = clf.predict(X_test_concat)
    probs = clf.predict_proba(X_test_concat)[:, 1]

    acc = accuracy_score(y_test, preds)
    auc = roc_auc_score(y_test, probs)
    acc_list.append(acc)
    auc_list.append(auc)

    print(f"[Fold {fold+1}] Accuracy: {acc:.4f} | AUC: {auc:.4f}")

    all_features.append(X_test_concat)
    all_labels.append(y_test)

# ===== 평균 출력 =====
print(f"\n✅ FBCSP(LDA) 평균 정확도: {np.mean(acc_list):.4f} ± {np.std(acc_list):.4f}")
print(f"✅ FBCSP(LDA) 평균 AUC: {np.mean(auc_list):.4f} ± {np.std(auc_list):.4f}")

# ===== 바플롯 시각화 =====
plt.figure(figsize=(8, 5))
plt.bar(range(1, N_FOLDS + 1), auc_list, color='skyblue')
plt.xlabel("Fold")
plt.ylabel("AUC")
plt.title("Fold-wise AUC - FBCSP+LDA (Subject Split)")
plt.xticks(range(1, N_FOLDS + 1))
plt.ylim(0.5, 1.05)
plt.grid(axis='y')
plt.tight_layout()
plt.savefig(os.path.join(SAVE_DIR, "auc_fbcsp_lda_subjectwise.png"))
plt.show()

# ===== t-SNE 시각화 추가 =====
features = np.concatenate(all_features)
labels = np.concatenate(all_labels)
tsne = TSNE(n_components=2, random_state=42)
X_tsne = tsne.fit_transform(features)

plt.figure(figsize=(6, 6))
for label in np.unique(labels):
    idx = labels == label
    plt.scatter(X_tsne[idx, 0], X_tsne[idx, 1], label=f"Class {label}", alpha=0.6)
plt.legend()
plt.title("t-SNE of FBCSP+LDA Features (Subject-wise CV)")
plt.grid(True)
plt.tight_layout()
plt.savefig(os.path.join(SAVE_DIR, "tsne_fbcsp_lda_subjectwise.png"))
plt.show()
